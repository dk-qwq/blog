{
  "name": "blog-astro-vue",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "check": "astro check && vue-tsc --noEmit -p tsconfig.vue.json",
    "build": "astro build && node scripts/build-search.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "type-check": "pnpm check",
    "new-post": "node scripts/new-post.js",
    "format": "biome format --write ./src",
    "lint": "biome check ./src",
    "lint:fix": "biome check --write ./src",
    "preinstall": "npx only-allow pnpm",
    "biome:ci": "biome ci ./src --reporter=github",
    "validate": "pnpm lint && pnpm check && pnpm test && pnpm build && pnpm test:links",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:links": "node scripts/check-links.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vercel": "^10.0.8",
    "@expressive-code/core": "^0.44.2",
    "@expressive-code/plugin-collapsible-sections": "^0.44.2",
    "@expressive-code/plugin-line-numbers": "^0.44.2",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource/roboto": "^5.2.10",
    "@iconify-json/fa6-brands": "^1.2.6",
    "@iconify-json/fa6-regular": "^1.2.4",
    "@iconify-json/fa6-solid": "^1.2.4",
    "@iconify-json/material-symbols": "^1.2.93",
    "@swup/astro": "^1.8.0",
    "@tailwindcss/typography": "^0.5.20",
    "astro": "6.4.8",
    "astro-expressive-code": "^0.44.2",
    "astro-icon": "^1.1.5",
    "hastscript": "^9.0.1",
    "katex": "^0.17.0",
    "markdown-it": "^14.2.0",
    "mdast-util-to-string": "^4.0.0",
    "overlayscrollbars": "^2.16.0",
    "pagefind": "^1.5.2",
    "photoswipe": "^5.4.4",
    "reading-time": "^1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-components": "^0.3.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-directive": "^3.0.1",
    "remark-directive-rehype": "^0.4.2",
    "remark-github-admonitions-to-directives": "^1.0.5",
    "remark-math": "^6.0.0",
    "remark-sectionize": "^2.1.0",
    "sanitize-html": "^2.17.7",
    "sharp": "^0.35.5",
    "stylus": "^0.64.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "unist-util-visit": "^5.1.0",
    "@astrojs/vue": "6.0.1",
    "vue": "^3.5.24"
  },
  "devDependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/ts-plugin": "^1.10.12",
    "@biomejs/biome": "2.5.14",
    "@rollup/plugin-yaml": "^4.1.2",
    "@types/hast": "^3.0.5",
    "@types/markdown-it": "^14.1.2",
    "@types/mdast": "^4.0.4",
    "@types/sanitize-html": "^2.16.1",
    "postcss-import": "^16.1.1",
    "postcss-nesting": "^13.0.2",
    "vitest": "^5.0.2",
    "vue-tsc": "^3.1.0",
    "@playwright/test": "^1.58.0",
    "postcss": "^8.4.49",
    "autoprefixer": "^10.4.20"
  },
  "packageManager": "pnpm@11.23.0"
}
