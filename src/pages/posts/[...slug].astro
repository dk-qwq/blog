---
import ArticlePage from "@components/page/ArticlePage.astro";
import FolderPage from "@components/page/FolderPage.astro";
import {
	buildContentTree,
	type ContentRouteTarget,
	flattenContentRoutes,
} from "@utils/content-tree";
import { getSortedPosts } from "@utils/content-utils";

export async function getStaticPaths() {
	const blogEntries = await getSortedPosts();
	const root = buildContentTree(blogEntries);
	const targets = flattenContentRoutes(root);

	return targets.map((target) => ({
		params: {
			slug: target.node.path,
		},
		props: {
			target,
		},
	}));
}

interface Props {
	target: ContentRouteTarget;
}

const { target } = Astro.props;
---

{
	target.type === "article" ? (
		<ArticlePage article={target.node} />
	) : (
		<FolderPage folder={target.node} />
	)
}
