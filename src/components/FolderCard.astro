---
import type { FolderNode } from "@utils/content-tree";
import { getArticles, getFolders } from "@utils/content-tree";
import { url } from "@utils/url-utils";
import { Icon } from "astro-icon/components";

interface Props {
	folder: FolderNode;
	class?: string;
	style?: string;
}

const { folder, class: className, style } = Astro.props;
const articleCount = getArticles(folder.contents).length;
const folderCount = getFolders(folder.contents).length;
const title = folder.landingArticle?.entry.data.title || folder.name;
const description = folder.landingArticle?.entry.data.description;
---

<a
	href={url(folder.url)}
	class:list={["folder-card card-base group", className]}
	style={style}
>
	<span class="folder-icon" aria-hidden="true">
		<Icon name="material-symbols:folder-open-outline-rounded" />
	</span>
	<div class="min-w-0 flex-1">
		<div class="flex items-center gap-3">
			<h2 class="folder-title text-90">{title}</h2>
			<span class="folder-label">目录</span>
		</div>
		{description && <p class="folder-description text-50">{description}</p>}
		<div class="folder-meta text-50">
			{articleCount > 0 && <span>{articleCount} 篇文章</span>}
			{articleCount > 0 && folderCount > 0 && <span aria-hidden="true">·</span>}
			{folderCount > 0 && <span>{folderCount} 个子目录</span>}
			{articleCount === 0 && folderCount === 0 && <span>暂无文章</span>}
		</div>
	</div>
	<Icon name="material-symbols:chevron-right-rounded" class="folder-arrow" aria-hidden="true" />
</a>

<style>
	.folder-card {
		display: flex;
		align-items: center;
		gap: 1.25rem;
		padding: 1.5rem 1.75rem;
		border: 1px solid var(--line-divider);
		transition: background-color 200ms, border-color 200ms;
	}

	.folder-card:hover,
	.folder-card:focus-visible {
		background: var(--btn-card-bg-hover);
		border-color: var(--primary);
	}

	.folder-card:focus-visible {
		outline: 2px solid var(--primary);
		outline-offset: -3px;
	}

	.folder-icon {
		display: grid;
		place-items: center;
		flex-shrink: 0;
		width: 3.5rem;
		height: 3.5rem;
		border-radius: 1rem;
		background: var(--btn-regular-bg);
		color: var(--btn-content);
		font-size: 1.75rem;
	}

	.folder-title {
		min-width: 0;
		font-size: 1.375rem;
		font-weight: 700;
		line-height: 1.5;
		overflow-wrap: anywhere;
	}

	.folder-label {
		flex-shrink: 0;
		color: var(--btn-content);
		font-size: 0.6875rem;
		letter-spacing: 0.1em;
	}

	.folder-description {
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		overflow: hidden;
		overflow-wrap: anywhere;
		margin-top: 0.25rem;
		font-size: 0.875rem;
		line-height: 1.6;
	}

	.folder-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: 0.5rem;
		font-size: 0.75rem;
		line-height: 1.5;
	}

	.folder-arrow {
		flex-shrink: 0;
		color: var(--primary);
		font-size: 1.75rem;
		transition: transform 200ms;
	}

	.folder-card:hover .folder-arrow {
		transform: translateX(0.25rem);
	}

	@media (max-width: 767px) {
		.folder-card {
			gap: 1rem;
			padding: 1.25rem;
		}
		.folder-icon {
			width: 2.75rem;
			height: 2.75rem;
			border-radius: 0.75rem;
			font-size: 1.5rem;
		}
		.folder-title {
			font-size: 1.125rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.folder-card,
		.folder-arrow {
			transition: none;
		}
		.folder-card:hover .folder-arrow {
			transform: none;
		}
	}
</style>
