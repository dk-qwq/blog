---
import type { FolderNode } from "@utils/content-tree";
import { url } from "@utils/url-utils";
import { Icon } from "astro-icon/components";

interface Props {
	folder: FolderNode;
	class?: string;
	style?: string;
}

const { folder, class: className, style } = Astro.props;

const articleCount = folder.articles.length;
const folderCount = folder.folders.length;

// 有 landing article 时优先使用它的标题，否则回退到文件夹名称。
const title = folder.landingArticle?.entry.data.title || folder.name;

const description = folder.landingArticle?.entry.data.description;
---

<a
	href={url(folder.url)}
	class:list={[
		"card-base group flex items-stretch",
		"w-full rounded-[var(--radius-large)]",
		"p-4 md:px-5 md:py-5",
		"border border-black/[0.04] dark:border-white/[0.06]",
		"hover:border-[var(--primary)]/25 hover:shadow-lg hover:shadow-black/[0.04]",
		"transition-all duration-300 active:scale-[0.99]",
		className,
	]}
	style={style}
>
	<div
		class="
			shrink-0 self-start flex items-center justify-center
			w-11 h-11 md:w-12 md:h-12 mr-4 rounded-xl
			bg-gradient-to-br from-[var(--enter-btn-bg)] to-[var(--card-bg)]
			border border-[var(--primary)]/10
			text-[var(--primary)]
			transition-transform duration-300 group-hover:scale-105
		"
	>
		<Icon
			name="material-symbols:folder-rounded"
			class="text-3xl"
		/>
	</div>

	<div class="min-w-0 flex-1 py-0.5">
		<div
			class="
				font-bold text-lg md:text-xl leading-7
				text-black/90 dark:text-white/90
				group-hover:text-[var(--primary)]
				transition-colors truncate
			"
		>
			{title}
		</div>

		{description && (
			<div
				class="
					mt-1 text-sm leading-5
					text-black/55 dark:text-white/55
					line-clamp-2
				"
			>
				{description}
			</div>
		)}

		<div class:list={["flex flex-wrap gap-2", description ? "mt-3" : "mt-2"]}>
			<span
				class="
					inline-flex items-center gap-1 rounded-md
					bg-black/[0.035] dark:bg-white/[0.06]
					px-2 py-1 text-xs font-medium
					text-black/55 dark:text-white/55
				"
			>
				<Icon name="material-symbols:article-outline-rounded" class="text-sm" />
				{articleCount} 篇文章
			</span>

			<span
				class="
					inline-flex items-center gap-1 rounded-md
					bg-black/[0.035] dark:bg-white/[0.06]
					px-2 py-1 text-xs font-medium
					text-black/55 dark:text-white/55
				"
			>
				<Icon name="material-symbols:folder-outline-rounded" class="text-sm" />
				{folderCount} 个文件夹
			</span>
		</div>
	</div>

	<div
		class="
			shrink-0 self-stretch ml-4 w-10 md:w-11 min-h-14
			flex items-center justify-center rounded-xl
			bg-[var(--enter-btn-bg)]
			group-hover:bg-[var(--enter-btn-bg-hover)]
			group-active:bg-[var(--enter-btn-bg-active)]
			transition-all duration-300
		"
	>
		<Icon
			name="material-symbols:chevron-right-rounded"
			class="
				text-3xl text-[var(--primary)]
				transition-transform duration-300
				group-hover:translate-x-0.5
			"
		/>
	</div>
</a>
